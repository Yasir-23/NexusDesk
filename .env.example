# NexusDesk Environment Configuration Example

# Port Allocations
NEXUSDESK_API_HTTP_PORT=56100
NEXUSDESK_POSTGRES_PORT=56132
NEXUSDESK_REDIS_PORT=56179
NEXUSDESK_ASPIRE_DASHBOARD_PORT=56188
NEXUSDESK_ASPIRE_OTLP_PORT=56189

# Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=nexusdesk_shared
POSTGRES_CONNECTION_STRING=Host=localhost;Port=56132;Database=nexusdesk_shared;Username=postgres;Password=postgres

# Redis Configuration
REDIS_CONNECTION_STRING=localhost:56179

# ASP.NET Core Environment
ASPNETCORE_ENVIRONMENT=Development
